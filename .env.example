# MoneyPrinterTurbo 环境变量配置
# 生产环境: 复制此文件为 .env 并填入真实密钥
# 所有变量都有对应 config.toml 回退值，不设置也能运行

# ── LLM API Keys ──
MPT_DEEPSEEK_API_KEY=sk-your-key
MPT_OPENAI_API_KEY=sk-your-key
MPT_MOONSHOT_API_KEY=
MPT_GEMINI_API_KEY=
MPT_QWEN_API_KEY=
MPT_AZURE_API_KEY=
MPT_VOLCENGINE_API_KEY=
MPT_GROK_API_KEY=
MPT_MINIMAX_API_KEY=
MPT_CLOUDFLARE_API_KEY=
MPT_MODELSCOPE_API_KEY=

# ── TTS / Speech ──
MPT_AZURE_SPEECH_KEY=
MPT_SILICONFLOW_API_KEY=
MPT_ELEVENLABS_API_KEY=

# ── Material APIs ──
MPT_PEXELS_API_KEYS=key1,key2
MPT_PIXABAY_API_KEYS=key1,key2

# ── Access Control ──
MPT_API_AUTH_KEY=your-api-auth-token
MPT_WEBUI_PASSWORD=your-webui-password

# ── Redis (optional, config.toml has defaults) ──
MPT_APP_REDIS_HOST=localhost

# ── MySQL / Auth (docker-compose.yml 引用) ──
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=mpt
MYSQL_USER=mpt
MYSQL_PASSWORD=mpt_secret
JWT_SECRET_KEY=change-me-in-production-please-9f8a7b6c
JWT_EXPIRE_MINUTES=10080

# ── Deployment (docker-compose.yml 引用) ──
# 部署主机地址，供容器间互访与 streamlit serverAddress 使用
SERVER_HOST=localhost
# 知识库服务凭据
KB_API_USER=
KB_API_PASS=
